# ============================================================
# Plantilla de variables del inference-service — EnergiAI
# ============================================================
# Copia este archivo como .env y rellena los valores.
# El .env real NO se sube al repo (esta en .gitignore).

# --- Modo de carga del modelo ---
# 'local' = lee el modelo del disco (desarrollo)
# 'oci'   = descarga el modelo desde OCI Object Storage (produccion)
MODEL_SOURCE=local

# --- Modo local ---
MODEL_PATH=../data-science/models/modelo_energiai.joblib

# --- Modo OCI (pedir estos datos al encargado de OCI) ---
OCI_NAMESPACE=
OCI_BUCKET=
OCI_MODEL_OBJECT=modelo_energiai.joblib
OCI_CONFIG_FILE=~/.oci/config
OCI_DESTINO_LOCAL=/tmp/modelo_energiai.joblib
